# Build stage
FROM node:22-alpine AS builder

WORKDIR /build

COPY package*.json ./
RUN npm ci --include=optional

COPY . .
RUN npm run build

# Final stage
FROM nginx:alpine

# Copy built assets
COPY --from=builder /build/dist /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose ports
EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
