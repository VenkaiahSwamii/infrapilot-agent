# Build Stage
FROM golang:1.26.4-alpine AS builder

WORKDIR /app

# Copy dependency manifests
COPY go.mod go.sum ./
RUN go mod download

# Copy backend source code
COPY . .

# Build production binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/infrapilot-backend ./cmd/server/main.go

# Production Stage
FROM alpine:3.19

RUN apk --no-cache add ca-certificates tzdata curl

WORKDIR /app

COPY --from=builder /app/infrapilot-backend /app/infrapilot-backend

EXPOSE 8080 8081

ENTRYPOINT ["/app/infrapilot-backend"]
