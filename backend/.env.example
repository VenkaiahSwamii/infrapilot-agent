# ============================================
# InfraPilot Enterprise - Configuration
# ============================================
# Copy this file to .env and adjust values
# ============================================

# --- Server ---
SERVER_PORT=8080
SERVER_MODE=release
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
SHUTDOWN_GRACE=15s

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=Venky@8686
DB_NAME=infrapilot_enterprise
DB_SSLMODE=disable

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# --- JWT ---
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=24h

# --- Logging ---
LOG_LEVEL=info
LOG_JSON=false
LOG_OUTPUT=stdout

# --- Worker Pools ---
METRIC_WORKERS=5
ALERT_WORKERS=3
LOG_WORKERS=3
DISCOVERY_WORKERS=2
AI_WORKERS=2
INVENTORY_WORKERS=2
QUEUE_BUFFER=100

# --- Metrics ---
METRICS_INTERVAL=5
HEARTBEAT_INTERVAL=15
RETENTION_DAYS=90
OFFLINE_THRESHOLD_SEC=60

# --- AI / OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024

# --- WebSocket ---
WS_READ_BUFFER=1024
WS_WRITE_BUFFER=1024
WS_WRITE_WAIT=10s
WS_PONG_WAIT=60s
WS_PING_INTERVAL=30s
WS_MAX_MESSAGE=524288

# --- Security ---
CORS_ORIGINS=*
RATE_LIMIT_PER_MIN=60
MAX_LOGIN_ATTEMPTS=5
ENFORCEMENT_MODE=enforcing
COMMAND_ALLOWLIST=

# --- TLS ---
TLS_ENABLED=true
MTLS_ENABLED=true
TLS_CERT_PATH=certs/server.crt
TLS_KEY_PATH=certs/server.key
TLS_CA_PATH=certs/ca.crt
TLS_PORT=8443
